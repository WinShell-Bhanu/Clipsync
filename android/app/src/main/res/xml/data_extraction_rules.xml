<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+ (Android 12+).
   Excludes sensitive data from cloud backups and device-to-device transfers.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the app SharedPreferences: contains AES encryption key and pairing state. -->
        <exclude domain="sharedpref" path="clipsync_prefs.xml"/>
        <exclude domain="sharedpref" path="clipsync_prefs_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Same exclusion for local device-to-device transfers (e.g. phone swap). -->
        <exclude domain="sharedpref" path="clipsync_prefs.xml"/>
        <exclude domain="sharedpref" path="clipsync_prefs_secure.xml"/>
    </device-transfer>
</data-extraction-rules>